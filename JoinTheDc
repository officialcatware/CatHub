local function hookDiscordCard()
	for _, descendant in gethui():GetDescendants() do
		if descendant.Name == "detailsholder" then
			local discordCard = descendant:FindFirstChild("dashboard") and descendant.dashboard:FindFirstChild("Discord")
			if discordCard and discordCard:FindFirstChild("Interact") then
				discordCard.Interact.MouseButton1Click:Connect(function()
					toast(
