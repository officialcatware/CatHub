						"discord.gg/" .. DISCORD_INVITE,
						string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", LocalPlayer.UserId)
					)
				end)
				return
			end
		end
	end
	error("CatHub: couldn't find Luna's Discord card on the home tab")
end
