local GamesTab = Window:CreateTab({ Name = "Games", Icon = "sports_esports", ImageSource = "Material", ShowTitle = true })
GamesTab:CreateSection("Available")

local loadedCleanups: { () -> () } = {}
local loadedGames: { [GameScript]: true } = {}

local function loadGame(entry: GameScript)
	local icon = gameIcon(entry.GameId)
	if loadedGames[entry] then
		toast("Already loaded", entry.ScriptName .. " is already running.", icon)
		return
	end
	if game.GameId ~= entry.GameId then
		toast("Wrong game", "Join " .. entry.Name .. " to load this script.", icon)
		return
	end

	table.insert(loadedCleanups, entry.Load(Window))
	loadedGames[entry] = true
	toast("Loaded " .. entry.ScriptName, "For " .. entry.Name, icon)
end

-- Luna buttons don't take an image, so the icon goes onto the button's own frame.
local function attachIcon(buttonName: string, image: string)
	local buttonFrame
	for _, descendant in gethui():GetDescendants() do
		if descendant.Name == buttonName and descendant:IsA("Frame") and descendant:FindFirstChild("Interact") then
			buttonFrame = descendant
			break
		end
	end
	assert(buttonFrame, "CatHub: couldn't find the Luna button frame for " .. buttonName)

	local icon = Instance.new("ImageLabel")
	icon.AnchorPoint = Vector2.new(1, 0.5)
	icon.Position = UDim2.new(1, -10, 0.5, 0)
	icon.Size = UDim2.new(1, 0, 1, -12)
	icon.BackgroundTransparency = 1
	icon.Image = image

	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1
	aspect.DominantAxis = Enum.DominantAxis.Height
	aspect.Parent = icon

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = icon

	icon.Parent = buttonFrame
end

