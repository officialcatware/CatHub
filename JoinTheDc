local HUB_NAME = "CatHub"
local TOAST_SECONDS = 4
local TOAST_WIDTH = 300
local TWEEN_FAST = TweenInfo.new(0.25, Enum.EasingStyle.Quint)

local COLOR_SURFACE = Color3.fromRGB(32, 30, 38)
local COLOR_STROKE = Color3.fromRGB(64, 61, 76)
local COLOR_TEXT = Color3.fromRGB(240, 240, 245)
local COLOR_MUTED = Color3.fromRGB(165, 162, 180)

local function gameIcon(gameId: number): string
	return string.format("rbxthumb://type=GameIcon&id=%d&w=150&h=150", gameId)
end

